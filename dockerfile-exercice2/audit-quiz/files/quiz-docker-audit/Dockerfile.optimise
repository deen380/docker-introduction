# ---------- Étape 1 : construction (Node, jetée après le build) ----------
FROM node:22-alpine AS build

WORKDIR /app

# Dépendances d'abord : cette couche est réutilisée tant que package*.json ne changent pas
COPY package.json package-lock.json ./
RUN npm ci

# Puis le code source, et la construction du site statique (dossier dist)
COPY . .
RUN npm run build

# ---------- Étape 2 : exécution (nginx non privilégié, sans Node) ----------
FROM nginxinc/nginx-unprivileged:alpine

# On ne garde que le site construit
COPY --from=build /app/dist /usr/share/nginx/html

# Cette image tourne avec un utilisateur non root et écoute sur le port 8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
